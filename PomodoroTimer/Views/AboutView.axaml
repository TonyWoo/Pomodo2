<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PomodoroTimer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="520"
             x:Class="PomodoroTimer.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource Thickness.Page}"
                    Spacing="18"
                    MaxWidth="680">
            <TextBlock Text="{Binding Title}"
                       Classes="pageTitle" />

            <Border Classes="card">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding VersionLabel}"
                                   Classes="caption" />
                        <TextBlock Text="{Binding Version}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding AuthorsLabel}"
                                   Classes="caption" />
                        <TextBlock Text="{Binding AuthorsText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
